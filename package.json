{
  "name": "bolao",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @bolao/api db:generate",
    "db:migrate": "pnpm --filter @bolao/api db:migrate",
    "db:studio": "pnpm --filter @bolao/api db:studio"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@scarf/scarf",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
