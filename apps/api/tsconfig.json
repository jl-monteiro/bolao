{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "isolatedModules": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "./dist",
    "removeComments": true,
    "sourceMap": true,
    "target": "ES2023"
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "prisma.config.ts"]
}
